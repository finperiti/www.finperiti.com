{
  "name": "finperiti-web-redesign",
  "version": "3.0.0",
  "private": true,
  "description": "finperiti.com rebuilt with the Finperiti.Web.V2 design system — static multi-page site, zero runtime dependencies.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs dist 5174 --watch",
    "preview": "node scripts/serve.mjs dist 5174",
    "test": "node scripts/build.mjs && node tests/qa.mjs",
    "docker:build": "docker build -t finperiti-web .",
    "docker:run": "docker run --rm -p 8080:8080 finperiti-web"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
